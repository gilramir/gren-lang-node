module Main exposing (main)

{-| `ChildProcess.run`, selected by the start argument: `node --version` with a
shell and without one, `true` with no arguments, a program that does not exist,
and a program stopped by its run duration and by its output limit, whose exit
code is -1.
-}

import ChildProcess
import Node
import Stream.Log
import Task exposing (Task)


main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen
            (\env ->
                ChildProcess.initialize
                    |> Task.andThen
                        (\cpPerm ->
                            when Array.get 2 env.args is
                                Just "Exec" ->
                                    { ChildProcess.defaultRunOptions | shell = ChildProcess.NoShell }
                                        |> ChildProcess.run cpPerm "node" [ "--version" ]
                                        |> Task.andThen (\result -> Stream.Log.bytes env.stdout result.stdout)
                                        |> Task.onError (\_ -> Node.setExitCode 1)

                                Just "ExecNoArgsNoShell" ->
                                    { ChildProcess.defaultRunOptions | shell = ChildProcess.NoShell }
                                        |> ChildProcess.run cpPerm "true" []
                                        |> Task.andThen (\_ -> Stream.Log.line env.stdout "Working")
                                        |> Task.onError (\_ -> Node.setExitCode 1)

                                Just "ExecShell" ->
                                    { ChildProcess.defaultRunOptions | shell = ChildProcess.DefaultShell }
                                        |> ChildProcess.run cpPerm "node" [ "--version" ]
                                        |> Task.andThen (\result -> Stream.Log.bytes env.stdout result.stdout)
                                        |> Task.onError (\_ -> Node.setExitCode 1)

                                Just "NotFound" ->
                                    { ChildProcess.defaultRunOptions | shell = ChildProcess.NoShell }
                                        |> ChildProcess.run cpPerm "foobar3" []
                                        |> Task.andThen (\result -> Stream.Log.bytes env.stdout result.stdout)
                                        |> Task.onError
                                            (\err ->
                                                when err is
                                                    ChildProcess.InitError inerr ->
                                                        if inerr.errorCode == "ENOENT" then
                                                            Stream.Log.line env.stdout "Process Not Found"

                                                        else
                                                            Stream.Log.line env.stdout inerr.errorCode

                                                    ChildProcess.ProgramError _ ->
                                                        Stream.Log.line env.stdout "Program Error"
                                            )

                                Just "Timeout" ->
                                    { ChildProcess.defaultRunOptions
                                        | shell = ChildProcess.NoShell
                                        , runDuration = ChildProcess.Milliseconds 100
                                    }
                                        |> ChildProcess.run cpPerm "sleep" [ "5" ]
                                        |> Task.map (\_ -> {})
                                        |> Task.onError (exitCodeOf env)

                                Just "MaxBytes" ->
                                    { ChildProcess.defaultRunOptions
                                        | shell = ChildProcess.NoShell
                                        , maximumBytesWrittenToStreams = 4
                                    }
                                        |> ChildProcess.run cpPerm "echo" [ "longer than four bytes" ]
                                        |> Task.map (\_ -> {})
                                        |> Task.onError (exitCodeOf env)

                                _ ->
                                    Stream.Log.line env.stdout "Invalid start argument"
                        )
            )


exitCodeOf : Node.Environment -> ChildProcess.FailedRun -> Task Never {}
exitCodeOf env err =
    when err is
        ChildProcess.InitError inerr ->
            Stream.Log.line env.stdout inerr.errorCode

        ChildProcess.ProgramError perr ->
            Stream.Log.line env.stdout ("Error: " ++ String.fromInt perr.exitCode)
