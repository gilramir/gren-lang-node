module Main exposing (main)

import Bytes exposing (Bytes)
import FileSystem
import FileSystem.Path as Path
import Node
import Stream
import Stream.Log
import Task exposing (Task)


main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen
            (\env ->
                FileSystem.initialize
                    |> Task.andThen (run env)
            )


run : Node.Environment -> FileSystem.Permission -> Task Never {}
run env fsPerm =
    let
        finish : Task String a -> Task Never {}
        finish task =
            task
                |> Task.map (\_ -> {})
                |> Task.onError
                    (\err ->
                        Stream.Log.line env.stdout ("FAIL: " ++ err)
                            |> Task.andThen (\_ -> Node.setExitCode 1)
                    )
    in
    when Array.get 2 env.args is
        Just "WriteFile" ->
            (getTempFilePath fsPerm "gren-fs-write.txt"
                |> Task.andThen
                    (\target ->
                        FileSystem.writeFile fsPerm (Bytes.fromString "write-content\n") target
                            |> Task.mapError FileSystem.errorToString
                    )
                |> finish
            )

        Just "AppendToFile" ->
            (getTempFilePath fsPerm "gren-fs-appendto.txt"
                |> Task.andThen
                    (\target ->
                        FileSystem.appendToFile fsPerm (Bytes.fromString "tail\n") target
                            |> Task.mapError FileSystem.errorToString
                    )
                |> finish
            )

        Just "WriteFileStreamReplace" ->
            (getTempFilePath fsPerm "gren-fs-wfs-replace.txt"
                |> Task.andThen (writeFileStreamTest fsPerm FileSystem.Replace "replace\n")
                |> finish
            )

        Just "WriteFileStreamReplaceFrom" ->
            (getTempFilePath fsPerm "gren-fs-wfs-replacefrom.txt"
                |> Task.andThen (writeFileStreamTest fsPerm (FileSystem.ReplaceFrom 3) "XY")
                |> finish
            )

        Just "Append" ->
            (getTempFilePath fsPerm "gren-file-system-append.txt"
                |> Task.andThen (writeFileStreamTest fsPerm FileSystem.Append "second\n")
                |> finish
            )

        Just "TruncateFile" ->
            (getTempFilePath fsPerm "gren-fs-truncate.txt"
                |> Task.andThen
                    (\target ->
                        FileSystem.truncateFile fsPerm 4 target
                            |> Task.mapError FileSystem.errorToString
                    )
                |> finish
            )

        Just "TruncateFilePad" ->
            (getTempFilePath fsPerm "gren-fs-truncate-pad.txt"
                |> Task.andThen
                    (\target ->
                        FileSystem.truncateFile fsPerm 4 target
                            |> Task.mapError FileSystem.errorToString
                    )
                |> finish
            )

        Just "CopyFile" ->
            (FileSystem.tmpDirectory fsPerm
                |> Task.mapError (\_ -> "Unable to resolve tmp directory")
                |> Task.map
                    (\dir ->
                        { src = Path.appendPosixString "gren-fs-copy-src.txt" dir
                        , dest = Path.appendPosixString "gren-fs-copy-dst.txt" dir
                        }
                    )
                |> Task.andThen
                    (\{ src, dest } ->
                        FileSystem.copyFile fsPerm dest src
                            |> Task.mapError FileSystem.errorToString
                    )
                |> finish
            )

        Just "Remove" ->
            (getTempFilePath fsPerm "gren-fs-remove.txt"
                |> Task.andThen
                    (\target ->
                        FileSystem.remove fsPerm { recursive = False } target
                            |> Task.mapError FileSystem.errorToString
                    )
                |> finish
            )

        Just "ReadFile" ->
            (getTempFilePath fsPerm "gren-fs-read.txt"
                |> Task.andThen
                    (\target ->
                        FileSystem.readFile fsPerm target
                            |> Task.mapError FileSystem.errorToString
                    )
                |> Task.andThen
                    (\bytes ->
                        when Bytes.toString bytes is
                            Just s ->
                                writeStdout env s

                            Nothing ->
                                Task.fail "Failed to decode bytes to string"
                    )
                |> finish
            )

        Just "ReadFileStreamBeginning" ->
            testReadFileStream env fsPerm FileSystem.Beginning |> finish

        Just "ReadFileStreamFrom" ->
            testReadFileStream env fsPerm (FileSystem.From 2) |> finish

        Just "ReadFileStreamBetween" ->
            testReadFileStream env fsPerm (FileSystem.Between { start = 1, end = 3 }) |> finish

        _ ->
            (Stream.Log.line env.stdout "Invalid start argument"
            )


-- TEST RUNNER
--
-- Each test is selected by a start argument (e.g. `node app WriteFile`). The
-- target file(s) live in the OS temp directory; their names are baked into the
-- test and mirrored by the runner (see test/requests.mjs), which sets up the
-- preconditions and verifies the outcome.
--
-- Write-style tests succeed by reaching the end of their task (the program then
-- exits 0 once the event loop drains). Read-style tests report their result by
-- writing it to stdout, which the runner captures. Any failure is mapped to a
-- logged message and exit code 1.


getTempFilePath : FileSystem.Permission -> String -> Task String Path.Path
getTempFilePath fsPerm name =
    FileSystem.tmpDirectory fsPerm
        |> Task.map (Path.appendPosixString name)
        |> Task.mapError (\_ -> "Unable to resolve tmp directory")


writeStdout : Node.Environment -> String -> Task String {}
writeStdout env str =
    Stream.writeStringAsBytes str env.stdout
        |> Task.map (\_ -> {})
        |> Task.mapError Stream.errorToString


{-| Shared by the three `writeFileStream` modes: open the stream, write the
payload, then close it.
-}
writeFileStreamTest : FileSystem.Permission -> FileSystem.WriteFileStreamMode -> String -> Path.Path -> Task String {}
writeFileStreamTest fsPerm mode payload target =
    FileSystem.writeFileStream fsPerm mode target
        |> Task.mapError FileSystem.errorToString
        |> Task.andThen
            (\writable ->
                Stream.write (Bytes.fromString payload) writable
                    |> Task.andThen (\_ -> Stream.closeWritable writable)
                    |> Task.mapError Stream.errorToString
            )


{-| Shared by the three `readFileStream` modes: open the stream, drain it to a
string, then report it on stdout.
-}
testReadFileStream : Node.Environment -> FileSystem.Permission -> FileSystem.ReadFileStreamMode -> Task String {}
testReadFileStream env fsPerm mode =
    getTempFilePath fsPerm "gren-fs-readstream.txt"
        |> Task.andThen
            (\target ->
                FileSystem.readFileStream fsPerm mode target
                    |> Task.mapError FileSystem.errorToString
            )
        |> Task.andThen readAllToString
        |> Task.andThen (writeStdout env)


readAllToString : Stream.Readable Bytes -> Task String String
readAllToString stream =
    Stream.readUntilClosed
        (\bytes acc ->
            when Bytes.toString bytes is
                Just s ->
                    Ok (acc ++ s)

                Nothing ->
                    Err "Failed to decode bytes to string"
        )
        ""
        stream
        |> Task.mapError Stream.errorToString
