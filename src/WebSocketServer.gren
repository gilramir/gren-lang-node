module WebSocketServer exposing (CloseReason, Connection, Listener, Message(..), Permission, Server, ServerError(..), connectionId, createServer, initialize, onClose, onConnection, removeListener)

{-| Create a WebSocket server that can accept connections and exchange messages.

Connections and their closing arrive in a [`Source`](Source#Source) you read
in a loop, and each connection is read from, written to and closed with
[WebSocketServer.Connection](WebSocketServer.Connection).

## Initialization

@docs Permission, Server, ServerError, initialize, createServer

## Connections

@docs Connection, connectionId

## Events

@docs Listener, onConnection, onClose, removeListener

## Message Types

@docs Message, CloseReason
-}

import Bytes exposing (Bytes)
import Extern exposing (Handle)
import Internal.Connection
import Source exposing (Source)
import Task exposing (Task)



-- INITIALIZATION


{-| The permission to start a WebSocket [`Server`](WebSocketServer.Server).

You get this from [`initialize`](WebSocketServer.initialize).
-}
type Permission
    = Permission


{-| The WebSocket server.
-}
type Server
    = Server Handle


{-| Error code and message from node.
Most likely from a failed attempt to start the server (e.g. `EADDRINUSE`).
-}
type ServerError
    = ServerError { code : String, message : String }


{-| Initialize the [`WebSocketServer`](WebSocketServer) module and get permission to create a server.

Only the application may call this, not a package it depends on (D258): a
package that needs it takes a `Permission` from its caller.
-}
@capability
initialize : Task x Permission
initialize =
    Task.succeed Permission


{-| Task to create a WebSocket server.

    WebSocketServer.createServer permission { host = "0.0.0.0", port_ = 8080 }
        |> Task.attempt ServerCreated

-}
createServer : Permission -> { host : String, port_ : Int } -> Task ServerError Server
createServer _ options =
    createServerWith (\code message -> ServerError { code = code, message = message }) TextMessage BinaryMessage options.host options.port_
        |> Task.map Server



-- CONNECTIONS


{-| An opaque handle representing a single WebSocket client connection.

Use [`connectionId`](WebSocketServer.connectionId) to get a comparable identifier for this connection.
-}
type alias Connection =
    Internal.Connection.Connection


{-| Get a comparable identifier for a connection.

Useful for storing connections in a `Dict Int Connection`.
-}
connectionId : Connection -> Int
connectionId conn =
    getConnectionIdExtern (Internal.Connection.handle conn)



-- EXTERNS


{-| The `ws` server inside a `Server`, which is what a listener's extern is
handed: a one-field constructor is a tagged record in a development build.
-}
serverHandle : Server -> Handle
serverHandle (Server handle) =
    handle


{-| The server is created with the two constructors of `Message`, since every
connection's stream of messages is set up when the connection arrives, whether
or not anything is listening for it yet.
-}
@extern(js, "WebSocketServer", "createServer")
createServerWith : (String -> String -> error) -> (String -> message) -> (Bytes -> message) -> String -> Int -> Task error Handle


@externPure(js, "WebSocketServer", "getConnectionId")
getConnectionIdExtern : Handle -> Int



-- MESSAGE TYPES


{-| A message received from a WebSocket client.
-}
type Message
    = TextMessage String
    | BinaryMessage Bytes


{-| The reason a WebSocket connection was closed.
-}
type alias CloseReason =
    { code : Int
    , reason : String
    }



-- LISTENING


{-| A connection or close listener on a server, which delivers until it is
[removed](#removeListener).
-}
type Listener
    = Listener Handle


{-| Deliver every new WebSocket client connection on a server into a
[`Source`](Source#Source), made a `msg` by the function you give.

Read incoming messages with
[`WebSocketServer.Connection.readable`](WebSocketServer-Connection#readable)
and send replies with
[`WebSocketServer.Connection.send`](WebSocketServer-Connection#send). The source
is yours: many listeners may deliver into one, and closing it is yours too.

    WebSocketServer.onConnection server events ClientConnected

-}
onConnection : Server -> Source msg -> (Connection -> msg) -> Task x Listener
onConnection server events handler =
    onConnectionExtern (serverHandle server) events (\conn -> handler (Internal.Connection.Connection conn))
        |> Task.map Listener


{-| Deliver every connection close on a server into a [`Source`](Source#Source),
made a `msg` by the function you give.

    WebSocketServer.onClose server events ClientDisconnected

-}
onClose : Server -> Source msg -> (Connection -> CloseReason -> msg) -> Task x Listener
onClose server events handler =
    onCloseExtern (serverHandle server) events (\conn code reason -> handler (Internal.Connection.Connection conn) { code = code, reason = reason })
        |> Task.map Listener


{-| Stop a listener delivering. Removing one twice is not an error.
-}
removeListener : Listener -> Task x {}
removeListener (Listener handle) =
    removeListenerExtern handle


@extern(js, "WebSocketServer", "onConnection")
onConnectionExtern : Handle -> Source msg -> (Handle -> msg) -> Task x Handle


@extern(js, "WebSocketServer", "onClose")
onCloseExtern : Handle -> Source msg -> (Handle -> Int -> String -> msg) -> Task x Handle


@extern(js, "WebSocketServer", "removeListener")
removeListenerExtern : Handle -> Task x {}
