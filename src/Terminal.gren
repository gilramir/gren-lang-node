module Terminal exposing
    ( Permission
    , Configuration
    , Size
    , initialize
    , Description
    , describe
    --
    , setStdInRawMode
    , setProcessTitle
    --
    , Listener
    , onResize
    , removeListener
    )


{-| This lets you interact with the user's terminal, if an interactive
terminal is connected to this application.

## Initialization

@docs Permission, Configuration, Size, initialize, Description, describe

## Commands

@docs setStdInRawMode, setProcessTitle

## Listening

@docs Listener, onResize, removeListener

-}


import Extern exposing (Handle)
import Source exposing (Source)
import Task exposing (Task)


{-| The permission for performing commands specified in this module.
-}
@derive(Eq)
type Permission
    = Permission


{-| The configuration of the attached interactive terminal.
-}
type alias Configuration =
    { permission : Permission
    , colorDepth : Int
    , columns : Int
    , rows : Int
    }


{-| Size of a terminal. Handy to know for drawing a text-based UI.
-}
type alias Size =
    { columns : Int
    , rows : Int
    }


-- INIT


{-| Initializes the `Terminal` subsystem.

`Nothing` is returned if this program isn't connected to an interactive terminal, which
can happen in CI-setups or when used as part of a unix pipe.
-}
@capability
initialize : Task x (Maybe Configuration)
initialize =
    initWith (\isTTY colorDepth columns rows -> { isTTY = isTTY, colorDepth = colorDepth, columns = columns, rows = rows })
        |> Task.map (\raw ->
            if raw.isTTY then
                Just
                    { permission = Permission
                    , colorDepth = raw.colorDepth
                    , columns = raw.columns
                    , rows = raw.rows
                    }

            else
                Nothing
        )


{-| What the attached interactive terminal is like, without the permission to
change it.
-}
type alias Description =
    { colorDepth : Int
    , columns : Int
    , rows : Int
    }


{-| The attached interactive terminal's colour depth and size, or `Nothing` when
there is none, as for [`initialize`](#initialize).

This is what a library needs to format its output for the terminal it will be
read in: a test runner choosing colours, or an argument parser wrapping its help
text. It mints no [`Permission`](#Permission), so any module may ask, where only
the application may call [`initialize`](#initialize) (geng-lang
`m1b-source.md` D258, `m1b-test.md` D292).
-}
describe : Task x (Maybe Description)
describe =
    initWith (\isTTY colorDepth columns rows -> { isTTY = isTTY, colorDepth = colorDepth, columns = columns, rows = rows })
        |> Task.map
            (\raw ->
                if raw.isTTY then
                    Just
                        { colorDepth = raw.colorDepth
                        , columns = raw.columns
                        , rows = raw.rows
                        }

                else
                    Nothing
            )


-- COMMANDS


{-| In it's default mode, `stdin` only sends data when the user hits the enter key.

If you switch over to raw mode, every keypress will be sent over the stream, and special
combinations like `Ctrl-C` will no longer trigger the kill signal.

Enable this when you need full control over how input is handled.
-}
setStdInRawMode : Permission -> Bool -> Task x {}
setStdInRawMode _ toggle =
    setStdInRawModeExtern toggle


{-| Set the title of the running process. This will usually display in
activity monitors or in the title bar of your terminal emulator.
-}
setProcessTitle : Permission -> String -> Task x {}
setProcessTitle _ title =
    setProcessTitleExtern title


-- EXTERNS


@extern(js, "Terminal", "init")
initWith : (Bool -> Int -> Int -> Int -> raw) -> Task x raw


@extern(js, "Terminal", "setStdInRawMode")
setStdInRawModeExtern : Bool -> Task x {}


@extern(js, "Terminal", "setProcessTitle")
setProcessTitleExtern : String -> Task x {}


-- LISTENING


{-| A resize listener, which delivers sizes until it is
[removed](#removeListener).
-}
type Listener
    = Listener Handle


{-| Deliver the terminal's new size into a [`Source`](Source#Source) every time
it changes, made a `msg` by the function you give. The source is yours: many
listeners may deliver into one, and closing it is yours too.
-}
onResize : Permission -> Source msg -> (Size -> msg) -> Task x Listener
onResize _ events toMsg =
    onResizeExtern events (\columns rows -> toMsg { columns = columns, rows = rows })
        |> Task.map Listener


{-| Stop a listener delivering sizes. Removing one twice is not an error.
-}
removeListener : Listener -> Task x {}
removeListener (Listener handle) =
    removeListenerExtern handle


@extern(js, "Terminal", "onResize")
onResizeExtern : Source msg -> (Int -> Int -> msg) -> Task x Handle


@extern(js, "Terminal", "removeListener")
removeListenerExtern : Handle -> Task x {}
