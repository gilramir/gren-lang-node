module HttpServer exposing
    -- Init
    ( Permission
    , initialize

    -- Server
    , Server
    , ServerError(..)
    , createServer

    -- Requests
    , Request
    , Method(..)
    , methodToString
    , bodyAsString
    , bodyFromJson
    , requestInfo
    , Listener
    , onRequest
    , removeListener
    )

{-| Create a server that can respond to HTTP requests.

Requests arrive in a [`Source`](Source#Source) you read in a loop, and each
one is answered with [`HttpServer.Response.send`](HttpServer.Response#send).

See the [example project](https://github.com/gren-lang/example-projects/blob/main/http-server/src/Main.gren) for what this looks like.
Or the [integration tests](https://github.com/gren-lang/integration-tests/blob/main/http-server/src/Main.gren) for a more robust example with routing and multiple response types.

## Initialization

@docs Permission, Server, ServerError, initialize, createServer

## Requests

@docs Request, Method, methodToString, bodyAsString, bodyFromJson, requestInfo

## Responding to requests

@docs Listener, onRequest, removeListener

See [HttpServer.Response](HttpServer.Response) for more details on responding to requests.

-}

import Bytes exposing (Bytes)
import Bytes.Decode as Decode
import Dict exposing (Dict)
import Extern exposing (Handle)
import Json.Encode
import Json.Decode
import Node
import Task exposing (Task)
import HttpServer.Response exposing (Response)
import Internal.Response
import Source exposing (Source)
import Url exposing (Url, Protocol(..))


-- INITIALIZATION


{-| The permission to start a [`Server`](HttpServer.Server).

You get this from [`initialize`](HttpServer.initialize).
-}
type Permission
    = Permission

{-| The HTTP server.
-}
type Server
    = Server Handle


{-| Error code and message from node.
Most likely from a failed attempt to start the server (e.g. `EADDRINUSE`).
Refer to the [node docs](https://nodejs.org/docs/latest-v18.x/api/errors.html) for details.
-}
type ServerError =
    ServerError { code : String, message : String }


{-| Initialize the [`HttpServer`](HttpServer) module and get permission to create a server.

Only the application may call this, not a package it depends on (D258): a
package that needs it takes a `Permission` from its caller.
-}
@capability
initialize : Task x Permission
initialize =
    Task.succeed Permission



{-| Task to initialize a [`Server`](HttpServer#Server).
-}
createServer : Permission -> { host : String, port_ : Int } -> Task ServerError Server
createServer _ options =
    createServerWith (\code message -> ServerError { code = code, message = message }) options.host options.port_
        |> Task.map Server


{-| The node server inside a `Server`, which is what the request listener's
extern is handed. A one-field constructor is its field only under `--optimize`;
in a development build it is a tagged record, so the handle is taken out here
rather than trusted to be the value.
-}
serverHandle : Server -> Handle
serverHandle (Server handle) =
    handle


@extern(js, "HttpServer", "createServer")
createServerWith : (String -> String -> error) -> String -> Int -> Task error Handle


-- REQUESTS


{-| An incoming HTTP reqest.
-}
type alias Request =
    { headers : Dict String String
    , method : Method
    , body : Bytes
    , url : Url
   }


{-| HTTP request methods.
-}
type Method
    = GET
    | HEAD
    | POST
    | PUT
    | DELETE
    | CONNECT
    | TRACE
    | PATCH
    | UNKNOWN String


{-| String representation of method
-}
methodToString : Method -> String
methodToString method =
    when method is
        GET ->
            "GET"
        
        HEAD ->
            "HEAD"
        
        POST ->
            "POST"
        
        PUT ->
            "PUT"
        
        DELETE ->
            "DELETE"
        
        CONNECT ->
            "CONNECT"
        
        TRACE ->
            "TRACE"
        
        PATCH ->
            "PATCH"
        
        UNKNOWN value ->
            value


{-| Turn the pieces of a request into a [`Request`](HttpServer.Request) record.

This is only used internally.
-}
toRequest :
    { url : String
    , headers : Array String
    , method : String
    , body : Bytes
    }
    -> Request
toRequest 
    { url
    , headers
    , method
    , body 
    } =
    { method = toMethod method
    , body = body
    , url = 
        Url.fromString url
            |> Maybe.withDefault
                { protocol = Http
                , port_ = Nothing
                , host = ""
                , path = ""
                , query = Nothing
                , fragment = Nothing
                }
    , headers =
        headers
            |> arrayPairs
            |> dictFromPairs
    }


{-| Get request body as a string.
-}
bodyAsString : Request -> Maybe String
bodyAsString req =
    Bytes.toString req.body


{-| Get request body as json.
-}
bodyFromJson : Json.Decode.Decoder a -> Request -> Result Json.Decode.Error a
bodyFromJson decoder req =
    req
        |> bodyAsString
        |> Maybe.withDefault "" -- or better if result holds a maybe?
        |> Json.Decode.decodeString decoder


{-| Get a string representation of the request.

Good for logging.
-}
requestInfo : Request -> String
requestInfo req =
    let
        method
            = when req.method is
                GET ->
                    "GET"

                HEAD ->
                    "HEAD"

                POST ->
                    "POST"

                PUT ->
                    "PUT"

                DELETE ->
                    "DELETE"

                CONNECT ->
                    "CONNECT"

                TRACE ->
                    "TRACE"

                PATCH ->
                    "PATCH"

                UNKNOWN m ->
                    "UNKNOWN(" ++ m ++ ")"
    in
    method ++ " " ++ (Url.toString req.url)


toMethod : String -> Method
toMethod s =
    when s is
        "GET" ->
            GET
        
        "HEAD" ->
            HEAD

        "POST" ->
            POST
        
        "PUT" ->
            PUT
        
        "DELETE" ->
            DELETE
        
        "CONNECT" ->
            CONNECT
        
        "TRACE" ->
            TRACE
        
        "PATCH" ->
            PATCH
        
        _ ->
            UNKNOWN s


arrayPairs : Array String -> Array (Array String)
arrayPairs a =
    let
        pair = 
            Array.takeFirst 2 a
        
        rest =
            Array.dropFirst 2 a
        
        allPairs =
            [ pair ] ++ when rest is
                [] ->
                    []
                
                _ ->
                    arrayPairs rest
    in
    allPairs


dictFromPairs : Array (Array String) -> Dict String String
dictFromPairs pairs =
    let
        -- Annotated so that it does not generalize over `Dict.set`'s
        -- constraint: a local constrained definition keeps its witness
        -- (geng-lang open-items, "A local constrained definition is not
        -- specialized"), which geng-hs-spec refuses.
        mapper : Array String -> Dict String String -> Dict String String
        mapper p dict =
            when p is
                [a, b] ->
                    Dict.set a b dict
                
                _ ->
                    dict
    in
    Array.foldl mapper Dict.empty pairs


-- LISTENING


{-| A request listener on a server, which delivers requests until it is
[removed](#removeListener).
-}
type Listener
    = Listener Handle


{-| Deliver every request the server receives into a [`Source`](Source#Source),
each one made a `msg`, with the [`Response`](HttpServer.Response#Response) that
answers it, by the function you give.

The source is yours: many listeners may deliver into one, and closing it is
yours too.

    Task.bracket Source.new Source.close <| \requests ->
        HttpServer.onRequest server requests GotRequest
            |> Task.andThen (\_ -> serve requests)

-}
onRequest : Server -> Source msg -> (Request -> Response -> msg) -> Task x Listener
onRequest server requests requestHandler =
    let
        build url headers method body response =
            requestHandler
                (toRequest { url = url, headers = headers, method = method, body = body })
                (Internal.Response.fromHandle response)
    in
    onRequestExtern (serverHandle server) requests build
        |> Task.map Listener


{-| Stop a listener delivering requests. Removing one twice is not an error.
-}
removeListener : Listener -> Task x {}
removeListener (Listener handle) =
    removeListenerExtern handle


@extern(js, "HttpServer", "onRequest")
onRequestExtern : Handle -> Source msg -> (String -> Array String -> String -> Bytes -> Handle -> msg) -> Task x Handle


@extern(js, "HttpServer", "removeListener")
removeListenerExtern : Handle -> Task x {}
