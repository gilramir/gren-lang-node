module Node exposing
    ( Environment
    , getEnvironment
    , Platform(..)
    , getPlatform
    , CpuArchitecture(..)
    , getCpuArchitecture
    , getEnvironmentVariables
    --
    , exit
    , exitWithCode
    , setExitCode
    --
    , Listener
    , onSignalInterrupt
    , onSignalTerminate
    , removeListener
    )


{-| What a program running on NodeJS can learn about where it runs, how it ends,
and the signals it can listen for.

A program is a `main : Task Never {}`. It ends when that task completes, with
the status set by [`setExitCode`](#setExitCode), or sooner with
[`exit`](#exit) or [`exitWithCode`](#exitWithCode).

## Environment information

@docs Environment, getEnvironment, getEnvironmentVariables, Platform, getPlatform, CpuArchitecture, getCpuArchitecture

## Exit

@docs exit, exitWithCode, setExitCode

## Signals

@docs Listener, onSignalInterrupt, onSignalTerminate, removeListener

-}


import Bytes exposing (Bytes)
import Dict exposing ( Dict )
import Task exposing ( Task )
import Extern exposing (Handle)
import FileSystem.Path exposing (Path)
import Stream
import Source exposing (Source)


-- ENVIRONMENT


{-| Contains information about the environment your application was initiated in.

* `platform` and `cpuArchitecture` tells you something about the operating system and machine your application is running on.
* `applicationPath` is the path to the currently executing program.
* `args` is an `Array` of the arguments passed to your application.
* `stdout`, `stderr` and `stdin` are streams you can use to communicate with the outside world. Take a closer look at the `Stream` module for more information.

-}
type alias Environment =
    { platform : Platform
    , cpuArchitecture : CpuArchitecture
    , applicationPath : Path
    , args : Array String
    , stdout : Stream.Writable Bytes
    , stderr : Stream.Writable Bytes
    , stdin : Stream.Readable Bytes
    }


{-| The `Environment` a `main : Task Never {}` runs in (geng-lang
`m1b-source.md` §SO12).

Only the application may call this, not a package it depends on (D258): the
environment is what `init` was handed and nobody else was.
-}
@capability
getEnvironment : Task x Environment
getEnvironment =
    initWith
        (\applicationPath platform arch args stdout stderr stdin ->
            { platform = platformFromString platform
            , cpuArchitecture = archFromString arch
            , applicationPath =
                -- The kernel read it with node's own `path`, which is `win32`'s
                -- on Windows and `posix`'s everywhere else.
                if platform == "win32" then
                    FileSystem.Path.fromWin32String applicationPath

                else
                    FileSystem.Path.fromPosixString applicationPath
            , args = args
            , stdout = stdout
            , stderr = stderr
            , stdin = stdin
            }
        )


{-| The platform, or operating system, that your application is running on.
-}
type Platform
    = Win32
    | Darwin
    | Linux
    | FreeBSD
    | OpenBSD
    | SunOS
    | Aix
    | UnknownPlatform String


{-| Retrieve the platform of the computer running the application.
-}
getPlatform : Task x Platform
getPlatform =
    getPlatformExtern
        |> Task.map platformFromString


platformFromString : String -> Platform
platformFromString platform =
    -- Node documents `process.platform` as one of a fixed set of lowercase
    -- strings, so this matches it as written. It used to call `String.toLower`,
    -- which put the Unicode case-mapping table in every node program for the
    -- sake of an ASCII word (`docs/m1b-str.md` §T24).
    when platform is
        "win32" ->
            Win32

        "darwin" ->
            Darwin

        "linux" ->
            Linux

        "freebsd" ->
            FreeBSD

        "openbsd" ->
            OpenBSD

        "sunos" ->
            SunOS

        "aix" ->
            Aix

        _ ->
            UnknownPlatform platform


{-| The CPU architecture your application is running on.
-}
type CpuArchitecture
    = Arm
    | Arm64
    | IA32
    | Mips
    | Mipsel
    | PPC
    | PPC64
    | S390
    | S390x
    | X64
    | UnknownArchitecture String


{-| Retrieve the CPU architecture of the computer running the application.
-}
getCpuArchitecture : Task x CpuArchitecture
getCpuArchitecture =
    getCpuArchitectureExtern
        |> Task.map archFromString


archFromString : String -> CpuArchitecture
archFromString arch =
    -- Node documents `process.arch` as one of a fixed set of lowercase
    -- strings, so this matches it as written. It used to call `String.toLower`,
    -- which put the Unicode case-mapping table in every node program for the
    -- sake of an ASCII word (`docs/m1b-str.md` §T24).
    when arch is
        "arm" ->
            Arm

        "arm64" ->
            Arm64

        "ia32" ->
            IA32

        "mips" ->
            Mips

        "mipsel" ->
            Mipsel

        "ppc" ->
            PPC

        "ppc64" ->
            PPC64

        "s390" ->
            S390

        "s390x" ->
            S390x

        "x64" ->
            X64

        _ ->
            UnknownArchitecture arch


{-| Get a `Dict` of environment variables.
-}
getEnvironmentVariables : Task x (Dict String String)
getEnvironmentVariables =
    getEnvironmentVariablesWith
        (\keys values ->
            Array.map2 (\key value -> { key = key, value = value }) keys values
                |> Dict.fromStringPairs
        )



-- EXIT


{-| End the program with exit status 0.

This is:

    exitWithCode 0
-}
exit : Task x a
exit =
    exitWithCode 0


{-| End the program with an exit status, without waiting for the rest of it.

The exit status can be read by other processes on your system. Any value other
than 0 is considered an error, but there are no other formal requirements for
what makes an exit status.

The task never completes. Standard output and standard error are written
through before the program ends, as they are when `main` completes, but
anything else still running is not waited for: a file being written or a
request in flight is abandoned.

A program that has only a status to set, and would rather finish what it is
doing, sets it with [`setExitCode`](#setExitCode) and lets `main` complete.
-}
exitWithCode : Int -> Task x a
exitWithCode code =
    exitWithCodeExtern code


{-| Set the error code that the program will return once it finishes.

Note: This will not terminate your program, so things like http calls
or writes to the filesystem will be allowed to complete. However,
the program will only exit once there are no ongoing tasks.
-}
setExitCode : Int -> Task x {}
setExitCode code =
    setExitCodeExtern code


-- EXTERNS


@extern(js, "Node", "init")
initWith : (String -> String -> String -> Array String -> stdout -> stderr -> stdin -> environment) -> Task x environment


@extern(js, "Node", "getPlatform")
getPlatformExtern : Task x String


@extern(js, "Node", "getCpuArchitecture")
getCpuArchitectureExtern : Task x String


@extern(js, "Node", "getEnvironmentVariables")
getEnvironmentVariablesWith : (Array String -> Array String -> environment) -> Task x environment


@extern(js, "Node", "exitWithCode")
exitWithCodeExtern : Int -> Task x a


@extern(js, "Node", "setExitCode")
setExitCodeExtern : Int -> Task x {}


-- SIGNALS


{-| A signal listener, which delivers until it is [removed](#removeListener).
-}
type Listener
    = Listener Handle


{-| Deliver `msg` into a [`Source`](Source#Source) every time the program
receives `SIGINT`, which is usually Ctrl-C in a terminal.

While a listener is installed the signal no longer ends the program: that is
yours to do, typically by letting `main` complete. The source is yours, and
many listeners may deliver into one.
-}
onSignalInterrupt : Source msg -> msg -> Task x Listener
onSignalInterrupt events msg =
    onSignalExtern "SIGINT" events msg
        |> Task.map Listener


{-| Deliver `msg` into a [`Source`](Source#Source) every time the program
receives `SIGTERM`. As with [`onSignalInterrupt`](#onSignalInterrupt), the
signal no longer ends the program while a listener is installed.
-}
onSignalTerminate : Source msg -> msg -> Task x Listener
onSignalTerminate events msg =
    onSignalExtern "SIGTERM" events msg
        |> Task.map Listener


{-| Stop a listener delivering. Once none is left for a signal, the signal ends
the program again. Removing one twice is not an error.
-}
removeListener : Listener -> Task x {}
removeListener (Listener handle) =
    removeListenerExtern handle


@extern(js, "Node", "onSignal")
onSignalExtern : String -> Source msg -> msg -> Task x Handle


@extern(js, "Node", "removeListener")
removeListenerExtern : Handle -> Task x {}
