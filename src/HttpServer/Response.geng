module HttpServer.Response exposing
    ( Response
    , send
    , setBody
    , setBodyAsBytes
    , setBodyAsString
    , setHeader
    , appendHeader
    , setStatus
    )

{-| Build up a response and send it.

Usually this will look something like this, in the loop that reads the
[`Source`](Source#Source) you [listened](HttpServer.onRequest) with, when it
gives you a `GotRequest` msg:

    GotRequest req res ->
        res
            |> Response.setHeader "Content-type" "text/html"
            |> Response.setBody ("<html>Hello there!</html>")
            |> Response.send

@docs Response, send, setBody, setBodyAsBytes, setBodyAsString, setHeader, appendHeader, setStatus

-}

import Bytes exposing (Bytes)
import Dict exposing (Dict)
import Extern exposing (Handle)
import Internal.Response exposing (Body(..))
import Task exposing (Task)


{-| An HTTP response.
-}
type alias Response =
    Internal.Response.Response


{-| Set the HTTP status code on a response.
-}
setStatus : Int -> Response -> Response
setStatus statusCode (Internal.Response.Response response) =
    Internal.Response.Response { response | status = statusCode }


{-| Set a header on a response, replacing any values it already has. Header
names are case-insensitive, so `"Content-Type"` and `"content-type"` are the
same header.
-}
setHeader : String -> String -> Response -> Response
setHeader key value (Internal.Response.Response response) =
    Internal.Response.Response
        { response
            | headers = Dict.set (String.toLower key) [ value ] response.headers
        }


{-| Add a value to a header, which is sent as a line of its own after the ones
the header already has. This is how a response sets more than one cookie, since
`set-cookie` lines cannot be joined. Header names are case-insensitive, as in
[`setHeader`](#setHeader).
-}
appendHeader : String -> String -> Response -> Response
appendHeader key value (Internal.Response.Response response) =
    Internal.Response.Response
        { response
            | headers =
                Dict.update
                    (String.toLower key)
                    (\values -> Just (Array.pushLast value (Maybe.withDefault [] values)))
                    response.headers
        }


{-| Alias for [`setBodyAsString`](HttpServer#setBodyAsString).
-}
setBody : String -> Response -> Response
setBody = setBodyAsString


{-| Set the body of the response to a string.
-}
setBodyAsString : String -> Response -> Response
setBodyAsString body (Internal.Response.Response response) =
    Internal.Response.Response
        { response | body = StringBody body }


{-| Set the body of the response to some bytes.
-}
setBodyAsBytes : Bytes -> Response -> Response
setBodyAsBytes body (Internal.Response.Response response) =
    Internal.Response.Response
        { response | body = BytesBody body }


-- SENDING


{-| Send a response. The status, the headers and the body are written and the
response is ended when the task runs.
-}
send : Response -> Task x {}
send (Internal.Response.Response response) =
    let
        keys =
            Dict.keys response.headers

        values =
            Dict.values response.headers
    in
    when response.body is
        StringBody body ->
            sendStringExtern response.key response.status keys values body

        BytesBody body ->
            sendBytesExtern response.key response.status keys values body


@extern(js, "HttpServer", "sendString")
sendStringExtern : Handle -> Int -> Array String -> Array (Array String) -> String -> Task x {}


@extern(js, "HttpServer", "sendBytes")
sendBytesExtern : Handle -> Int -> Array String -> Array (Array String) -> Bytes -> Task x {}
